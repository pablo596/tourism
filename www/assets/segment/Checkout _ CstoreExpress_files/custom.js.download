if ($.cookie('user_id') !== undefined) {
  if($.cookie('user_name')!=""){
    $("#div-account").html('<a href="#">My Account <i class="ion-ios-arrow-down"></i></a><ul><li><a href="/my-account/">My Perfil</a></li><li><a href="/my-orders/">My Orders</a></li><li><a href="/contact/">Contact</a></li><li><a href="/my-cart/">Shopping cart</a></li><li><a href="/checkout/">Checkout</a></li><li><a href="#" id="signOff">Sign off</a></li> </ul>')
    $("#signOff").click(function(){
        $("#signOff").html('<i class="fa fa-spinner fa-pulse"></i>')
        $.ajax({
          method: "POST",
          url: "signoff.php",
        })
        .done(function( msg ) {
          window.location.reload();
        })
        .fail(function() {
          window.location.reload();
        })
    })
  }
