Array.prototype.in_array=function(){
    for(var j in this){
        if(this[j]==arguments[0]){
            return true;
        }
    }
    return false;    
}
Array.prototype.remove = function(x) { 
    var i;
    for(i in this){
        if(i.toString() == x.toString()){
            this.splice(i,1)
        }
    }
}
