  /* ----------------------------------------------------------- */
  /*  1. ME GUSTAS 
  /* ----------------------------------------------------------- */

  $(".megusta").click(function(){

    var idv = this.id
        idv = idv.split("-")
      updateMegusta(idv[0],idv[1])
      switch(idv[0]){
        case "1":
          togleMegustas(1,idv[1])

        break
        case "2":
          togleMegustas(2,idv[1])
        break
        case "3":
          togleMegustas(3,idv[1])
        break
        case "4":
          togleMegustas(4,idv[1])
        break
        case "5":
          togleMegustas(5,idv[1])
        break
        default:
          togleMegustas(0,idv[1])
        break

      }
  })

  function togleMegustas(va,id){

    for (var i = 1; i <= 5; i++) {
      if (i <= va) {
        $("#"+i+"-"+id).addClass("active")

      }else{
        $("#"+i+"-"+id).removeClass("active")

      }
      
    };
  }

  function updateMegusta(va,id){
    var megusta = $.ajax({
            method: "POST",
            url: "/updateMegusta.php",
            data: { va: va, id: id}
          })

    megusta.fail(function() {
      updateMegusta(va,id)
    })
  }


