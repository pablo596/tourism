var testA="ningun producto agregado al carrito"

function alerta(t1,t2,ti,ico){
  return '<div class="alert alert-'+ti+' alert-dismissible" role="alert"><button type="button" class="close" data-dismiss="alert"><span aria-hidden="true">&times;</span><span class="sr-only">Close</span></button><i class="fa '+ico+'"></i> <strong>'+t1+'</strong> <small>'+t2+'</small>  </div>'
};


$("#btn-pedido").click(function(){

      
      if ($("#lo-hi").val() == 1) {
        if ($.cookie('id_atuspies') !== undefined) {
            realizarPedido();
        }else{
            $("#div_noti").html(alerta("Alerta",testA,"warning","fa-exclamation-triangle"))
        }

        
      }else{
        window.location.href="../ingreso/registro"
      }
})


